# MementoOS MVP — Umgebungsvariablen
# OHNE gesetzte URL läuft die App im MOCK-Modus (In-Memory-Beispieldaten,
# kein Netzwerk, kein Konto nötig) — ideal für lokale Entwicklung/Demo.
#
# Ohne Konfiguration startet die App in Produktion NICHT: ein Deploy mit
# vergessenen Variablen bricht mit einer Fehlermeldung ab, statt still den
# Demo-Modus zu zeigen. Der Build (`pnpm build`) bleibt davon unberührt.

# Supabase (Projekt in der Region EU — Frankfurt anlegen)
# Beide Werte gehören zusammen: nur einer von beiden gesetzt = Fehler.
# NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   (aeltere Projekte: NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>)

# Nur serverseitig (niemals ins Frontend!).
# ACHTUNG: Der service_role-Schlüssel umgeht Row-Level-Security vollständig.
# Er ist ausschließlich für signierte Datei-URLs und Seed gedacht — niemals
# zum Lesen eines Falls. Gelesen wird er nur in src/lib/env.ts.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Ausnahme: Mock-Modus in einer Produktions-Umgebung ausdrücklich erlauben
# (nur für Vorführungen ohne Datenbank). Standard: nicht gesetzt.
# MEMENTO_ALLOW_MOCK=1
